+// TEMP-remaining-profile: removed after capture.
+#[cfg(not(target_arch = "wasm32"))]
+thread_local! { static PROFILE_PHASE: std::cell::Cell<Option<&'static str>> = const { std::cell::Cell::new(None) }; }
+#[cfg(not(target_arch = "wasm32"))]
+pub fn saved_profile_phase() -> Option<&'static str> { PROFILE_PHASE.with(|phase| phase.get()) }
+#[cfg(not(target_arch = "wasm32"))]
+pub struct SavedProfilePhase { previous: Option<&'static str>, stage: &'static str, reads: Option<CacheReadProbe> }
+#[cfg(not(target_arch = "wasm32"))]
+impl SavedProfilePhase {
+    pub fn start(stage: &'static str) -> Self {
+        let previous = PROFILE_PHASE.with(|phase| phase.replace(Some(stage)));
+        Self { previous, stage, reads: Some(CacheReadProbe::start(true)) }
+    }
+}
+#[cfg(not(target_arch = "wasm32"))]
+impl Drop for SavedProfilePhase {
+    fn drop(&mut self) {
+        for entry in self.reads.take().unwrap().finish() {
+            tracing::info!(target: "saved_content_detail", stage=self.stage, source=?entry.source, relationship=?entry.relationship, outcome=entry.outcome, requests=entry.requests, "[PERF-remaining-read]");
+        }
+        PROFILE_PHASE.with(|phase| phase.set(self.previous));
+    }
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub struct SavedProfileTimer { phase: &'static str, component: &'static str, started: std::time::Instant }
+#[cfg(not(target_arch = "wasm32"))]
+pub fn saved_profile_timer(component: &'static str) -> Option<SavedProfileTimer> {
+    saved_profile_phase().map(|phase| SavedProfileTimer { phase, component, started: std::time::Instant::now() })
+}
+#[cfg(not(target_arch = "wasm32"))]
+impl Drop for SavedProfileTimer {
+    fn drop(&mut self) {
+        tracing::info!(target: "saved_content_detail", stage=self.phase, component=self.component, elapsed_us=self.started.elapsed().as_micros(), "[PERF-remaining-component]");
+    }
+}
