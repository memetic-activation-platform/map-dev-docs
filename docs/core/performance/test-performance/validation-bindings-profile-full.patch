+
+// Temporary [PERF-validation-bindings] native transport observation.
+thread_local! {
+    static VALIDATION_INVOCATIONS: RefCell<Option<HashMap<String, (usize, u128, u128)>>> = const { RefCell::new(None) };
+}
+pub fn begin_validation_invocations() {
+    VALIDATION_INVOCATIONS.with(|observations| *observations.borrow_mut() = Some(HashMap::new()));
+}
+pub fn finish_validation_invocations() -> HashMap<String, (usize, u128, u128)> {
+    VALIDATION_INVOCATIONS.with(|observations| observations.borrow_mut().take().unwrap_or_default())
+}
+pub fn record_validation_invocation(name: &str, total_us: u128, backend_us: u128) {
+    VALIDATION_INVOCATIONS.with(|observations| {
+        if let Some(observations) = observations.borrow_mut().as_mut() {
+            let entry = observations.entry(name.to_owned()).or_default();
+            entry.0 += 1;
+            entry.1 += total_us;
+            entry.2 += backend_us;
+        }
+    });
+}
