+// Temporary [PERF-validation-bindings] probes; assertions below remain unchanged.
+struct ValidationProfilePhase {
+    name: &'static str,
+    started: std::time::Instant,
+    cache: holons_core::core_shared_objects::read_observations::CacheReadProbe,
+}
+impl ValidationProfilePhase {
+    fn start(name: &'static str) -> Self {
+        holons_core::core_shared_objects::read_observations::begin_validation_invocations();
+        info!(target: "validation_profile", phase=name, "[PERF-validation-bindings-start]");
+        Self {
+            name,
+            started: std::time::Instant::now(),
+            cache: holons_core::core_shared_objects::read_observations::CacheReadProbe::start(true),
+        }
+    }
+    fn finish(self) {
+        let elapsed_us = self.started.elapsed().as_micros();
+        let reads = self.cache.finish();
+        let mut groups = std::collections::BTreeMap::new();
+        for read in reads {
+            let key = (
+                read.relationship.map(|name| name.to_string()).unwrap_or_else(|| "<node>".into()),
+                read.outcome,
+            );
+            let entry = groups.entry(key).or_insert((0usize, 0usize));
+            entry.0 += read.requests;
+            entry.1 += 1;
+        }
+        for ((relationship, outcome), (requests, sources)) in groups {
+            info!(target: "validation_profile", phase=self.name, relationship, outcome, requests, sources, "[PERF-validation-bindings-cache]");
+        }
+        for (dance, (calls, total_us, backend_us)) in
+            holons_core::core_shared_objects::read_observations::finish_validation_invocations()
+        {
+            info!(target: "validation_profile", phase=self.name, dance, calls, total_us, backend_us, "[PERF-validation-bindings-transport]");
+        }
+        info!(target: "validation_profile", phase=self.name, elapsed_us, "[PERF-validation-bindings-phase]");
+    }
+}
